 <% if(errors.length>0) {%>

                            <div class="bg-red-100 border border-red-400 text-red-700 px-2 py-2 rounded relative mb-4" role="alert">
                                <strong claas="font-bold">
                                        Error!
                                </strong>
                                <span class="block sm:inline">
                                    <% errors.forEach(error=>{%>
                                        <li > <%= error %> </li>

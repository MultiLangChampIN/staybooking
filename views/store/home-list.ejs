<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head") %>

  <body>
    <%- include("../partials/nav") %>

      <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 mb-10 max-w-2xl">
        <h1 class="text-5xl text-gray-800 font-bold text-center mb-8">Welcome to Airbnb</h1>
        <h3 class="text-3xl text-red-500 font-bold text-center mb-8">Here are our registered homes</h3>
      </main>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 px-8 mt-8">
        <% registeredHomes.forEach(home=> { %>
          <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition duration-300 overflow-hidden border-l-4 border-red-500 hover:scale-105 transform">
            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-48 object-cover">
            <div class="p-6">
              <div class="flex justify-between items-start mb-2">
                <h2 class="text-xl font-bold text-gray-800">
                  <%= home.houseName %>
                </h2>
                
              </div>
              <p class="text-gray-600 text-sm mb-4">
                <%= home.location %>
              </p>
              <div class="flex justify-between items-center mb-4">
                <span class="text-red-500 font-bold text-lg">$<%= home.pricePerNight %>/night</span>
                <div class="flex items-center gap-1">
                  <span class="text-yellow-400">★</span>
                  <span class="text-gray-700 font-semibold">
                    <%= home.rating %>
                  </span>
                </div>
              </div>
              <div class="flex gap-2">
                 <%- include("../partials/favourite",{home:home}) %>
                 <a href="/store/<%=home._id %>">
                  <button  class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-lg transition">
                 
                  view
                 
                </button>
                 </a>
                 
                <button class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-3 rounded-lg transition">Book
                  Now
                </button>
              </div>
            </div>
          </div>
          <% }) %>
      </div>
      
      
  </body>

</html>
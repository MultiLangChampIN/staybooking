<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head") %>

  <body>
    <%- include("../partials/nav") %>

      <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 mb-10 max-w-2xl">

        <h3 class="text-3xl text-red-500 font-bold text-center mb-8">Here are your favourite homes</h3>
      </main>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 px-8 mt-8">
        <% favouriteHomes.forEach(home=> { %>
          <div
            class="bg-white rounded-lg shadow-md hover:shadow-xl transition duration-300 overflow-hidden border-l-4 border-red-500 hover:scale-105 transform">
            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-48 object-cover">
            <div class="p-6">
              <div class="flex justify-between items-start mb-2">
                <h2 class="text-xl font-bold text-gray-800">
                  <%= home.houseName %>
                </h2>
                <button class="text-2xl cursor-pointer" onclick="toggleFavorite(this)">❤️</button>
              </div>
              <p class="text-gray-600 text-sm mb-4">
                <%= home.location %>
              </p>
              <div class="flex justify-between items-center mb-4">
                <span class="text-red-500 font-bold text-lg">$<%= home.pricePerNight %>/night</span>
                <div class="flex items-center gap-1">
                  <span class="text-yellow-400">★</span>
                  <span class="text-gray-700 font-semibold">
                    <%= home.rating %>
                  </span>
                </div>
              </div>
              <div class="flex gap-2">
                <button
                  class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded transition">
                  <a href="/store/<%=home._id %>">
                    view
                  </a>
                </button>
                <form action="/favourites/delete/<%=home._id %>" method="POST">
                  <button type="submit" class="w-full bg-red-500 hover:bg-black text-white font-bold py-2 px-4 rounded transition">
                    Unfavourite
                  </button>
                </form>
                <button class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded transition">
                  Book Now
                </button>
              </div>

            </div>
          </div>
          <% }) %>
      </div>

      <script>
        function toggleFavorite(btn) {
          btn.textContent = btn.textContent === '❤️' ? '🤍' : '❤️';
        }
      </script>
  </body>

</html>
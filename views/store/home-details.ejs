<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head") %>

  <body>
    <%- include("../partials/nav") %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 mb-10 max-w-5xl">
      <h3 class="text-3xl text-red-500 font-bold text-center mb-8">You are in Home detail page</h3>
      
      <div class="flex gap-8">
        <!-- Left Side - Image -->
        <div class="w-1/2">
          <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-96 object-cover rounded-lg">
        </div>
        
        <!-- Right Side - Information -->
        <div class="w-1/2">
          <h2 class="text-3xl font-bold mb-2"><%= home.houseName %></h2>
          
          <p class="text-gray-500 mb-6 text-sm">
            <span class="font-semibold">📍 Location:</span> <%= home.location %>
          </p>
          
          <div class="border-t border-b py-4 mb-6">
            <p class="text-gray-700 mb-4"><strong>Description:</strong></p>
            <p class="text-gray-600 leading-relaxed"><%= home.description %></p>
          </div>
          
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="bg-gray-100 p-4 rounded-lg">
              <p class="text-gray-600 text-sm">Price per Night</p>
              <p class="text-2xl font-bold text-green-600">$<%= home.pricePerNight %></p>
            </div>
            <div class="bg-gray-100 p-4 rounded-lg">
              <p class="text-gray-600 text-sm">Rating</p>
              <p class="text-2xl font-bold text-yellow-500">⭐ <%= home.rating %>/5</p>
            </div>
          </div>
          
          <div class="mb-6">
            <p class="text-gray-700 font-semibold mb-2">Amenities:</p>
            <p class="text-gray-600"><%= home.amenities %></p>
          </div>
          
          <%- include("../partials/favourite") %>
          
          <button class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-4 rounded-lg transition">
            Book Now
          </button>
        </div>
      </div>
    </main>
 
  

</body>

</html>
<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head") %>

    <body>
        <%- include("../partials/nav") %>

        <div class="max-w-sm mx-auto mt-12 border border-gray-200 rounded-lg shadow-md overflow-hidden">
                <div class="flex border-b border-gray-200">
                    <button
                        class="tab-btn  flex-1 py-3 px-4 text-center font-medium text-gray-700 bg-gray-50 hover:bg-gray-100   transition"
                        onclick="showTab('login')">Login</button>
                    <button
                        class="tab-btn active flex-1 py-3 px-4 text-center font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 transition border-b-2 border-red-500"
                        onclick="showTab('signup')">Sign Up</button>
                </div>

                <div id="signup" class="form-content active p-6">

                    <h2 class="text-2xl font-bold text-gray-800 mb-4">Sign Up</h2>
                        
                    <form method="POST" action="/signup" class="space-y-4">

                    
                            <%- include("../partials/error") %>

                        <input type="text" name="firstName" placeholder="first name" value="<%=oldInput.firstName ? oldInput.firstName:''%>"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                            required>
                        <input type="text" name="lastName" placeholder="last name"  value="<%=oldInput.lastName ? oldInput.lastName:''%>"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500">
                        <input type="email" name="email" placeholder="Email"  value="<%=oldInput.email ? oldInput.email:''%>"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                            required>
                        <input type="password" name="password" placeholder="Password"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                            required>
                        <input type="password" name="confirm-password" placeholder="Confirm Password"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                            required>

                        <div class="mb-4">
                            <p class="block text-sm font-medium text-gray-700 mb-2">User Type</p>
                            <div class="flex items-center space-x-6">
                                <div class="flex items-center">
                                    <input type="radio" value="host" name="userType" id="host"
                                        class="w-4 h-4 text-red-500 focus:ring-2 focus:ring-red-500" required>
                                    <label for="host" class="ml-2 text-sm text-gray-700">Host</label>
                                </div>
                                <div class="flex items-center">
                                    <input type="radio" value="guest" name="userType" id="guest"
                                        class="w-4 h-4 text-red-500 focus:ring-2 focus:ring-red-500" checked required>
                                    <label for="guest" class="ml-2 text-sm text-gray-700">Guest</label>
                                </div>

                            </div>

                        </div>
                        <div class="flex items-center mb-4">
                            <input id="terms" type="checkbox" name="terms"
                                class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft">
                            <label for="terms"
                                class="select-none ms-2 text-sm font-medium text-heading">i agree to terms and conditions</label>
                        </div>



                        <button type="submit"
                            class="w-full py-2 bg-red-500 text-white font-medium rounded-lg hover:bg-red-600 transition " onclick="showTab('signup')">Sign
                            Up</button>
                    </form>
                </div>
                
            </div>
            <script>
                function showTab(tabName) {
                    // Hide all form content
                    // const contents = document.querySelectorAll('.form-content');
                    // contents.forEach(content => content.classList.add('hidden','hidden'));
                    
                    // Remove active class from all buttons
                    const buttons = document.querySelectorAll('.tab-btn');
                    buttons.forEach(button => button.classList.remove('active', 'border-b-2', 'border-red-500'));
                    
                    // Show selected tab
                    if(tabName==='login'){
                        window.location.href='/login';
                    }
                    
                    
                    // Add active class to clicked button
                    event.target.classList.add('active', 'border-b-2', 'border-red-500');
                }

               
            </script>
  </body>

</html>
